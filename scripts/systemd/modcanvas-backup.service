[Unit]
Description=ModCanvas tutor-state backup (memory store + .tutor archive)

[Service]
Type=oneshot
# The backup script resolves .tutor/ and backups/ from cwd — pin it to the repo.
WorkingDirectory=/home/deviant/Projects/ModCanvas
# Absolute paths only: systemd user units don't inherit the login shell PATH.
ExecStart=/home/deviant/.local/bin/node /home/deviant/Projects/ModCanvas/scripts/backup-state.mjs
